{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sc-workflows",
  "version": "0.1.0",
  "description": "Chinese-first Codex workflows for video transcription, subtitle editing, and English-to-Chinese video localization and publishing.",
  "author": {
    "name": "anbulang",
    "url": "https://github.com/anbulang"
  },
  "homepage": "https://github.com/anbulang/sc-workflows",
  "repository": "https://github.com/anbulang/sc-workflows",
  "license": "MIT",
  "keywords": [
    "codex",
    "skills",
    "video",
    "subtitles",
    "localization",
    "chinese"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "SC: Video Workflows",
        "shortDescription": "视频转录、字幕剪辑与英文视频中文化发布",
        "longDescription": "一组面向中文创作者的可复用视频工作流：先分析内容再完成转录、剪辑与字幕交付，或把英文视频本地化为带中文配音、字幕和配套文章的成片。",
        "developerName": "anbulang",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/anbulang/sc-workflows",
        "defaultPrompt": [
          "使用 SC: 视频字幕剪辑分析这个视频，并生成校对后的字幕。",
          "使用 SC: 视频中文化与文章发布，把这个英文视频制作成中文配音和中文字幕版本。"
        ],
        "brandColor": "#1677FF",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/logo.svg"
      }
    }
  }
}
